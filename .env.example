# Copy to .env and replace each placeholder with your own project values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
STATUS_UPDATE_SECRET=replace_with_a_long_random_secret

# Runtime: Supabase transaction pooler (port 6543) or session pooler (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require"
# Prisma CLI migrations: Supabase direct connection, or session pooler if IPv6 is unavailable.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
